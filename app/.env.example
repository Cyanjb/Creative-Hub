# ─────────────────────────────────────────────────────────────
# Creative Hub — local proxy credentials
# Copy this file to `.env` and fill in only the keys you have.
# `.env` is gitignored. Keys never reach the browser.
# ─────────────────────────────────────────────────────────────

PORT=8787

# --- Text / reasoning models ---------------------------------
# console.anthropic.com
ANTHROPIC_API_KEY=
# platform.openai.com
OPENAI_API_KEY=

# --- Image models --------------------------------------------
# aistudio.google.com — powers "Nano Banana" (Gemini image models)
GEMINI_API_KEY=

# --- Creative platforms --------------------------------------
# dev.runwayml.com
RUNWAY_API_KEY=
# higgsfield.ai (account API key)
HIGGSFIELD_API_KEY=
HIGGSFIELD_SECRET=
# openart.ai
OPENART_API_KEY=
