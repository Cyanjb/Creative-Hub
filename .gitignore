# Secrets. The V1 app keeps API keys in .env and the Express proxy reads them
# from there. Committing one of these publishes working keys.
.env
.env.*
!.env.example
*.key
*.pem
secrets.json

# Dependencies. Large, regenerated by npm install, never committed.
node_modules/
.pnp
.pnp.js

# Build output. Regenerated by the build, never committed.
dist/
build/
.vite/
*.tsbuildinfo

# Logs and caches
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.cache/
.parcel-cache/
.eslintcache

# Local generation output. Images and video are large and belong in cloud
# storage or the local assets folder, not in git history.
rendered/
*.mp4
*.mov
*.webm

# Editor and OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# V2 managed runtime data (outside repository).
*.sqlite*
*.db-*
managed-data/
staging/
backups/
test-results/
playwright-report/
